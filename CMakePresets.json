{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "conf-common",
            "description": "General settings that apply to all configurations",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}"
        },
        {
            "name": "conf-unixlike-common",
            "description": "Unix-like OS settings.",
            "hidden": true,
            "inherits": "conf-common",
            "condition": {
                "type": "inList",
                "string": "${hostSystemName}",
                "list": [
                    "Linux",
                    "Darwin"
                ]
            }
        },
        {
            "name": "hip-debug",
            "displayName": "HIP debug build.",
            "description": "For local development with hip.",
            "inherits": "conf-unixlike-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "tyvi_ENABLE_CLANG_TIDY": "OFF",
                "tyvi_ENABLE_CPPCHECK": "OFF",
                "tyvi_BACKEND": "hip"
            }
        },
        {
            "name": "hip-release",
            "displayName": "HIP release build.",
            "description": "For local development with hip.",
            "inherits": "conf-unixlike-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "tyvi_ENABLE_CLANG_TIDY": "OFF",
                "tyvi_ENABLE_CPPCHECK": "OFF",
                "tyvi_BACKEND": "hip"
            }
        },
 	{
             "name": "cuda-debug",
             "displayName": "Cuda debug build",
             "description": "For local development with cuda.",
             "inherits": "hip-debug",
             "binaryDir": "$env{TMPDIR}/tyvi-build/${presetName}",
             "cacheVariables": {
                 "CMAKE_CXX_STANDARD": {
                     "type": "STRING",
                     "value": "23"
                 },
                 "CMAKE_CUDA_FLAGS": {
 			"type": "STRING",
 			"value": "-DHOP_TARGET_CUDA"
 		},
                "tyvi_BACKEND": "cuda"
             }
 	},
        {
            "name": "cpu-debug",
            "displayName": "CPU debug build.",
            "description": "For local development.",
            "inherits": "conf-unixlike-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "tyvi_ENABLE_CLANG_TIDY": "OFF",
                "tyvi_ENABLE_CPPCHECK": "OFF",
                "tyvi_BACKEND": "cpu"
            }
        },
        {
            "name": "cpu-debug-static-analysis",
            "displayName": "CPU debug build.",
            "description": "For local development.",
            "inherits": "conf-unixlike-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "tyvi_ENABLE_CLANG_TIDY": "ON",
                "tyvi_ENABLE_CPPCHECK": "ON",
                "tyvi_BACKEND": "cpu"
            }
        },
        {
            "name": "cpu-release",
            "displayName": "CPU release build.",
            "description": "For local development.",
            "inherits": "conf-unixlike-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "tyvi_ENABLE_CLANG_TIDY": "OFF",
                "tyvi_ENABLE_CPPCHECK": "OFF",
                "tyvi_BACKEND": "cpu"
            }
        }
    ]
}
